<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for a per-user LaunchAgent that builds the recommendation feed nightly.
  Not installed by the repository. Replace __PROJECT__ (absolute repository path) and
  __PROFILE__ (Netflix profile name), then follow "Scheduling" in docs/recommendations.md.
  If the Mac is asleep at the scheduled time, launchd runs the job when it wakes.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ru7100.feed-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT__/scripts/feed-nightly.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RU7100_FEED_PROFILE</key>
    <string>__PROFILE__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>Nice</key>
  <integer>10</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT__/local-data/logs/feed-nightly.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/local-data/logs/feed-nightly.log</string>
</dict>
</plist>
