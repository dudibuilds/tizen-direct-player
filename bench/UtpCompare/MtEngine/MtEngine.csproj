<Project Sdk="Microsoft.NET.Sdk">
  <!-- MonoTorrent main's ClientEngine restricted to uTP, for the libtorrent interop check (scripts/utp-compare-engine.sh).
       Build with -p:MonoTorrentSrc=/path/to/monotorrent/src. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UtpCompare.MtEngine</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MonoTorrentSrc)/MonoTorrent.Client/MonoTorrent.Client.csproj" />
    <ProjectReference Include="$(MonoTorrentSrc)/MonoTorrent/MonoTorrent.csproj" />
    <ProjectReference Include="$(MonoTorrentSrc)/MonoTorrent.BEncoding/MonoTorrent.BEncoding.csproj" />
    <ProjectReference Include="$(MonoTorrentSrc)/MonoTorrent.Connections/MonoTorrent.Connections.csproj" />
    <ProjectReference Include="$(MonoTorrentSrc)/MonoTorrent.Factories/MonoTorrent.Factories.csproj" />
    <ProjectReference Include="$(MonoTorrentSrc)/MonoTorrent.Messages/MonoTorrent.Messages.csproj" />
    <ProjectReference Include="$(MonoTorrentSrc)/MonoTorrent.PieceWriter/MonoTorrent.PieceWriter.csproj" />
  </ItemGroup>
</Project>
