<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Import Project="../core/Core.props" />
  <ItemGroup>
    <!-- Platform-neutral probe files; Tizen-only files are excluded. -->
    <Compile Include="../probe/**/*.cs" Exclude="../probe/Program.cs;../probe/Tizen/**;../probe/obj/**;../probe/bin/**" LinkBase="probe" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <EmbeddedResource Include="../probe/sintel.torrent" LogicalName="sintel.torrent" />
  </ItemGroup>
</Project>
